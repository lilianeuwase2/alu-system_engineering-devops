#!/usr/bin/env bash
# This script installs Nginx and configures a 301 redirect from /redirect_me

set -e

# Update package list
sudo apt update

# Install Nginx
sudo apt install -y nginx

# Start and enable Nginx
sudo systemctl enable nginx
sudo systemctl start nginx

# Backup default Nginx config
sudo cp /etc/nginx/sites-available/default /etc/nginx/sites-available/default.bak

# Insert a multi-line 301 redirect block into the server block
sudo tee -a /etc/nginx/sites-available/default > /dev/null << 'EOF'

location /redirect_me {
    return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
}
EOF

# Test Nginx configuration
sudo nginx -t

# Reload Nginx
sudo systemctl reload nginx

echo "Redirection configured: /redirect_me -> https://www.youtube.com/watch?v=QH2-TGUlwu4"

