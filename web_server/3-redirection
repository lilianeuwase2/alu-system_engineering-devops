#!/usr/bin/env bash
# This script configures an Nginx server on a brand new Ubuntu machine
# to redirect /redirect_me to a specific URL using a 301 Moved Permanently directive.

# 1. Install Nginx
sudo apt-get update -y
sudo apt-get install -y nginx

# 2. Define the redirection rule
# We will insert this block after the 'server_name _;' line
# The location block uses a prefix match 'location /redirect_me'
# which will correctly handle both /redirect_me and /redirect_me/
# Note the escaped slashes (\) for the URL, which sed requires.
REDIRECT_RULE="\\\n\\\n    location /redirect_me {\\\n        return 301 https:\/\/www.youtube.com\/watch?v=QH2-TGUlwu4;\\\n    }"

# 3. Use sed to insert the rule into the default config file
# This command appends (a) the REDIRECT_RULE after the line matching 'server_name _;'
sudo sed -i "/server_name _;/a ${REDIRECT_RULE}" /etc/nginx/sites-available/default

# 4. Test Nginx configuration and restart the service
if sudo nginx -t; then
    sudo service nginx restart
else
    echo "Nginx configuration test failed. Exiting." >&2
    exit 1
fi