#!/usr/bin/env bash
# This script configures an Nginx server on a brand new Ubuntu machine
# to redirect /redirect_me to a specific URL using a 301 Moved Permanently directive.

# 1. Install Nginx
sudo apt-get update -y
sudo apt-get install -y nginx

# 2. Add the redirection rule using sed
# This 'sed' command finds the line 'server_name _;' and appends (a) the new location block after it.
# The '\' at the end of each line is necessary for the 'a' command to treat it as a multi-line append.
# We must escape the forward slashes in the URL for sed.
sudo sed -i '/server_name _;/a \
\
    location /redirect_me { \
        return 301 https:\/\/www.youtube.com\/watch?v=QH2-TGUlwu4; \
    }' /etc/nginx/sites-available/default

# 3. Test configuration and restart Nginx
if sudo nginx -t; then
    sudo service nginx restart
else
    # If config test fails, print error and exit with an error code
    echo "Nginx configuration test failed. Please check the config file." >&2
    exit 1
fi
