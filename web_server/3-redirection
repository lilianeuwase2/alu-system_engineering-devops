#!/usr/bin/env bash

# This script configures an Nginx server on a brand new Ubuntu machine
# to redirect /redirect_me to a specific URL using a 301 Moved Permanently directive.

# 1. Install Nginx (based on 1-install_nginx_web_server)
echo "Updating package list and installing Nginx..."
sudo apt-get update -y
sudo apt-get install -y nginx

# 2. Configure the 301 Redirection
# The redirection rule is added to the default configuration file.
# The 'sed' command is used to append the new multi-line 'location' block
# immediately after the 'server_name _;' line within the server block.

REDIRECT_URL="https://www.youtube.com/watch?v=QH2-TGUlwu4"
NGINX_CONF="/etc/nginx/sites-available/default"

echo "Adding 301 redirection for /redirect_me to Nginx configuration..."
# The '\' at the end of each line allows multiline insertion with the 'a' (append) command.
# Spaces are used for proper indentation.
sudo sed -i "/server_name _;/a\
    location /redirect_me {\
        return 301 ${REDIRECT_URL};\
    }" ${NGINX_CONF}

# 3. Test Configuration and Restart Nginx
echo "Testing Nginx configuration and restarting service..."
if sudo nginx -t; then
    sudo service nginx restart
    echo "Nginx configured and restarted successfully."
else
    echo "Nginx configuration test failed. Please check the config file."
    exit 1
fi
