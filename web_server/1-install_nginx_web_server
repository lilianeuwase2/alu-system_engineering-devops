#!/usr/bin/env bash
# This script installs and configures Nginx to serve a custom page.

# Update package information
sudo apt-get update

# Install Nginx
# -y answers "yes" to all prompts
sudo apt-get install -y nginx

# Create the custom HTML content
# We use printf and tee with sudo to write to the protected file
printf "Holberton School\n" | sudo tee /var/www/html/index.html

# Restart Nginx using the service command (as systemctl is forbidden)
# This ensures Nginx is started and serves the new file
sudo service nginx restart

exit 0




